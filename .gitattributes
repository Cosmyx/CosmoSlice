# Every text file is LF in the repository and on disk, on every OS.
* text=auto eol=lf

# Binary assets: never normalised, never diffed as text.
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.ico binary
*.icns binary
*.3mf binary
*.stl binary
*.ttf binary
*.xlsx binary
*.dll binary
*.lib binary
*.exe binary
